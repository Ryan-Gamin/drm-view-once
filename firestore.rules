rules_version = '2';

// OneView: all reads and writes go through the server (Firebase Admin SDK),
// which bypasses these rules. Browsers get no direct access, so nobody can
// write a username claim or read image data straight from Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
